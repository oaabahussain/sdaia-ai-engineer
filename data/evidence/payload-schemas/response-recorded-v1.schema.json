{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "response_version",
    "response_kind",
    "response"
  ],
  "properties": {
    "response_version": {
      "type": "integer",
      "const": 1
    },
    "response_kind": {
      "type": "string",
      "enum": [
        "OPTION",
        "MULTI_OPTION",
        "BOOLEAN",
        "NUMBER",
        "TEXT",
        "STRUCTURED"
      ]
    },
    "response": {
      "type": "object"
    }
  }
}
