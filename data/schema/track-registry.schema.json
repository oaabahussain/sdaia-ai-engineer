{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "track-registry.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "default_track_id",
    "tracks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "default_track_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
