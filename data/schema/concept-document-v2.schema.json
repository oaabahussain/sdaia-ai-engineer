{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConceptDocumentV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain_id",
    "concepts"
  ],
  "properties": {
    "domain_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "term",
          "definition_ar",
          "definition_en",
          "id",
          "order"
        ],
        "properties": {
          "term": {
            "type": "string"
          },
          "definition_ar": {
            "type": "string"
          },
          "definition_en": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
