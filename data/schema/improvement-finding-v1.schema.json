{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "observed_signal",
    "evidence_refs",
    "scope",
    "uncertainty",
    "hypothesis",
    "counter_evidence",
    "recommended_investigation",
    "expected_impact",
    "owner",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "finding_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal_type",
        "signal_ref",
        "summary"
      ],
      "properties": {
        "signal_type": {
          "type": "string",
          "enum": [
            "metric_regression",
            "anomaly",
            "friction",
            "coverage_gap",
            "quality_drift",
            "underuse"
          ]
        },
        "signal_ref": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "platform",
            "track",
            "domain",
            "feature",
            "tranche",
            "provider",
            "release"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence",
        "limitations"
      ],
      "properties": {
        "confidence": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "evidence_class",
        "causal"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "type": "string",
          "enum": [
            "CORRELATION",
            "MECHANISM_HYPOTHESIS",
            "PRIOR_EVIDENCE"
          ]
        },
        "causal": {
          "const": false
        }
      }
    },
    "counter_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommended_investigation": {
      "type": "string",
      "minLength": 1
    },
    "recommended_experiment": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "expected_impact": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "REVIEWED",
        "EXPERIMENTING",
        "RESOLVED",
        "DISMISSED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
