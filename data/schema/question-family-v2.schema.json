{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "family_id",
    "track_id",
    "domain_id",
    "objective_id",
    "concept_ids",
    "misconception_ids",
    "learning_goal",
    "decision_being_tested",
    "cognitive_level",
    "intended_difficulty",
    "scenario_model",
    "variable_model",
    "correct_reasoning",
    "common_wrong_reasoning",
    "evidence_refs",
    "language_requirements",
    "accessibility_requirements",
    "generation_policy",
    "quality_policy",
    "release_policy",
    "lifecycle",
    "version"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "family_id": {
      "type": "string",
      "minLength": 1
    },
    "track_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "domain_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "objective_id": {
      "type": "string",
      "minLength": 1
    },
    "concept_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "misconception_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "learning_goal": {
      "type": "string",
      "minLength": 1
    },
    "decision_being_tested": {
      "type": "string",
      "minLength": 1
    },
    "cognitive_level": {
      "type": "string",
      "enum": [
        "remember",
        "understand",
        "apply",
        "analyze",
        "evaluate",
        "create"
      ]
    },
    "intended_difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "scenario_model": {
      "type": "object"
    },
    "variable_model": {
      "type": "object"
    },
    "correct_reasoning": {
      "type": "string",
      "minLength": 1
    },
    "common_wrong_reasoning": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "language_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "ar",
          "en"
        ]
      }
    },
    "accessibility_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generation_policy": {
      "type": "string",
      "minLength": 1
    },
    "quality_policy": {
      "type": "string",
      "minLength": 1
    },
    "release_policy": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "version": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
