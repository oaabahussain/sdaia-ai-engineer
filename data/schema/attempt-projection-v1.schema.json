{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projection_type",
    "store_id",
    "through_store_seq",
    "policy_version",
    "generated_at",
    "assessment_attempt_id",
    "form_id",
    "authoritative_revision",
    "content_release_id",
    "exam_profile_ref",
    "scoring_policy_ref",
    "unresolved_reference_count"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "projection_type": {
      "const": "ATTEMPT"
    },
    "store_id": {
      "type": "string",
      "minLength": 1
    },
    "through_store_seq": {
      "type": "integer",
      "minimum": 0
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "assessment_attempt_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "form_id": {
      "type": "string",
      "minLength": 1
    },
    "authoritative_revision": {
      "type": "integer",
      "minimum": 0
    },
    "responses": {
      "type": "array"
    },
    "unanswered_item_version_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolved_reference_count": {
      "type": "integer",
      "minimum": 0
    },
    "content_release_id": {
      "type": "string",
      "minLength": 1
    },
    "exam_profile_ref": {
      "type": "string",
      "minLength": 1
    },
    "scoring_policy_ref": {
      "type": "string",
      "minLength": 1
    },
    "identity_resolution_version": {
      "type": "string",
      "minLength": 1
    }
  }
}
