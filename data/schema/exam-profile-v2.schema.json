{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExamProfileV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "track_id",
    "version",
    "evidence_status",
    "question_count",
    "section_sizes",
    "weights"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "track_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "evidence_status": {
      "type": "string",
      "minLength": 1
    },
    "question_count": {
      "type": "integer",
      "minimum": 1
    },
    "section_sizes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "const": "all"
          }
        ]
      }
    },
    "weights": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
