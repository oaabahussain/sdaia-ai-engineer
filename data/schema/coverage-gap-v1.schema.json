{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gap_id",
    "track_id",
    "domain_id",
    "objective_id",
    "concept_ids",
    "misconception_ids",
    "cognitive_level",
    "intended_difficulty",
    "languages",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "gap_id": {
      "type": "string",
      "minLength": 1
    },
    "track_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "domain_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "objective_id": {
      "type": "string",
      "minLength": 1
    },
    "concept_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "misconception_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cognitive_level": {
      "type": "string",
      "enum": [
        "remember",
        "understand",
        "apply",
        "analyze",
        "evaluate",
        "create"
      ]
    },
    "intended_difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "ar",
          "en"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "filled",
        "deferred"
      ]
    },
    "requested_count": {
      "type": "integer",
      "minimum": 1
    }
  }
}
