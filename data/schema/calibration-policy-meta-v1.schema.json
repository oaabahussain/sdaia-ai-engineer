{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "scope",
    "evidence_basis",
    "effective_from",
    "observed_data_refs",
    "owner",
    "approver",
    "reconsideration_trigger"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "global",
            "track",
            "domain",
            "provider",
            "risk_class"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "global"
              }
            }
          },
          "then": {},
          "else": {
            "required": [
              "ref"
            ]
          }
        }
      ]
    },
    "evidence_basis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "effective_from": {
      "type": "string",
      "format": "date-time"
    },
    "observed_data_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "reconsideration_trigger": {
      "type": "string",
      "minLength": 1
    }
  }
}
