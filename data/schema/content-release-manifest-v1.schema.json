{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "track_id",
    "status",
    "item_version_ids",
    "source_policy_version",
    "quality_policy_version",
    "review_policy_version",
    "exam_profile_id",
    "exam_profile_version",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "track_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "DEV",
        "REVIEW",
        "CANARY",
        "ACTIVE",
        "DEPRECATED",
        "RETIRED",
        "QUARANTINED"
      ]
    },
    "item_version_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "quality_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "review_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "exam_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "exam_profile_version": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "origin": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ACTIVE"
          }
        }
      },
      "then": {
        "required": [
          "content_hash"
        ]
      }
    }
  ]
}
