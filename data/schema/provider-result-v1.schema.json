{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "run_id",
    "provider",
    "model",
    "model_version",
    "policy_version",
    "latency_ms",
    "output",
    "provenance_ref",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "output": {},
    "provenance_ref": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
