{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "provider",
    "model",
    "policy_version",
    "metrics",
    "decision",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evaluation_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "metrics": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correctness",
        "source_fidelity",
        "arabic_quality",
        "english_quality",
        "distractor_quality",
        "format_compliance",
        "latency_ms",
        "cost"
      ],
      "properties": {
        "correctness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source_fidelity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "arabic_quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "english_quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "distractor_quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "format_compliance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "cost": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "ABSTAIN"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
