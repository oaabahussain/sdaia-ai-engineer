{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "mode",
    "requires_evidence_for_added_claims",
    "allow_external_facts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "STRICT",
        "GROUNDED",
        "EXPANSIVE"
      ]
    },
    "requires_evidence_for_added_claims": {
      "type": "boolean"
    },
    "allow_external_facts": {
      "type": "boolean"
    }
  }
}
