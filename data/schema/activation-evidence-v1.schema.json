{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "activation_evidence_id",
    "release_id",
    "tranche_id",
    "content_hash",
    "policy_versions",
    "provider_evaluation_refs",
    "coverage_delta",
    "duplicate_findings",
    "correctness_summary",
    "bilingual_summary",
    "accessibility_summary",
    "review_summary",
    "runtime_verification",
    "canary_observation",
    "blockers",
    "evidence_sufficiency",
    "decision",
    "actor",
    "approver",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "activation_evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "tranche_id": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quality_policy_version",
        "review_policy_version",
        "calibration_policy_versions"
      ],
      "properties": {
        "quality_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "review_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "calibration_policy_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provider_evaluation_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "coverage_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closed_gap_ids",
        "added_family_count"
      ],
      "properties": {
        "closed_gap_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "added_family_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "duplicate_findings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "finding_count"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "REVIEW_REQUIRED",
            "ABSTAIN",
            "NOT_APPLICABLE"
          ]
        },
        "finding_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "correctness_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "REVIEW_REQUIRED",
            "ABSTAIN",
            "NOT_APPLICABLE"
          ]
        }
      }
    },
    "bilingual_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "REVIEW_REQUIRED",
            "ABSTAIN",
            "NOT_APPLICABLE"
          ]
        }
      }
    },
    "accessibility_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "REVIEW_REQUIRED",
            "ABSTAIN",
            "NOT_APPLICABLE"
          ]
        }
      }
    },
    "review_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "unresolved_count"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "REVIEW_REQUIRED",
            "ABSTAIN",
            "NOT_APPLICABLE"
          ]
        },
        "unresolved_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "runtime_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL"
          ]
        }
      }
    },
    "canary_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_classes",
        "observation_ref"
      ],
      "properties": {
        "evidence_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "observation_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_sufficiency": {
      "type": "string",
      "enum": [
        "SUFFICIENT",
        "INSUFFICIENT"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "PROMOTE",
        "HOLD",
        "REVISE",
        "QUARANTINE",
        "ROLLBACK"
      ]
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
