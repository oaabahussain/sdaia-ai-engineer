{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "scope",
    "evidence_basis",
    "labeled_set_ref",
    "embedding_profile",
    "same_language",
    "cross_language",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "track",
            "domain"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_basis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "labeled_set_ref": {
      "type": "string",
      "minLength": 1
    },
    "embedding_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "version"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "same_language": {
      "$ref": "#/definitions/thresholds"
    },
    "cross_language": {
      "$ref": "#/definitions/thresholds"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "definitions": {
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_lower_bound",
        "duplicate_threshold"
      ],
      "properties": {
        "review_lower_bound": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "duplicate_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
