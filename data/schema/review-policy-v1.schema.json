{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "new_ai_requires_human",
    "high_risk_requires_human",
    "quarantined_requires_human",
    "deterministic_sampling_rate"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "new_ai_requires_human": {
      "type": "boolean"
    },
    "high_risk_requires_human": {
      "type": "boolean"
    },
    "quarantined_requires_human": {
      "type": "boolean"
    },
    "deterministic_sampling_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
