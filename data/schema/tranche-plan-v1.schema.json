{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tranche_id",
    "expansion_plan_id",
    "track_id",
    "requests",
    "policy_refs",
    "risk_distribution",
    "capacity_inputs",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tranche_id": {
      "type": "string",
      "minLength": 1
    },
    "expansion_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "track_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "coverage_gap_id",
          "requested_families"
        ],
        "properties": {
          "coverage_gap_id": {
            "type": "string",
            "minLength": 1
          },
          "requested_families": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "policy_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_policy_version",
        "quality_policy_version",
        "review_policy_version",
        "tranche_calibration_policy_version"
      ],
      "properties": {
        "source_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "quality_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "review_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "tranche_calibration_policy_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "risk_distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "low",
        "medium",
        "high"
      ],
      "properties": {
        "low": {
          "type": "integer",
          "minimum": 0
        },
        "medium": {
          "type": "integer",
          "minimum": 0
        },
        "high": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "capacity_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_capacity",
        "recent_yield_rate"
      ],
      "properties": {
        "review_capacity": {
          "type": "integer",
          "minimum": 0
        },
        "recent_yield_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "PLANNED",
        "RUNNING",
        "PARTIAL",
        "COMPLETED",
        "PAUSED",
        "FAILED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
