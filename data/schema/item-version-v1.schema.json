{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "item_version_id",
    "family_id",
    "version",
    "content",
    "provenance_refs",
    "release_state",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "item_version_id": {
      "type": "string",
      "minLength": 1
    },
    "family_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "content": {
      "type": "object"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provenance_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "release_state": {
      "type": "string",
      "enum": [
        "DRAFT",
        "CANARY",
        "ACTIVE",
        "DEPRECATED",
        "RETIRED",
        "QUARANTINED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "predecessor_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "release_state": {
            "enum": [
              "CANARY",
              "ACTIVE",
              "DEPRECATED",
              "RETIRED"
            ]
          }
        }
      },
      "then": {
        "required": [
          "content_hash"
        ]
      }
    }
  ]
}
