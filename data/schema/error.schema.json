{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "error.schema.json",
  "type": "object",
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "invalid_anon_id",
            "validation_failed",
            "conflict",
            "not_found"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
