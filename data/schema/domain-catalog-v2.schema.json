{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DomainCatalogV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "track_id",
    "track_version",
    "domains"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "track_id": {
      "type": "string",
      "minLength": 1
    },
    "track_version": {
      "type": "string",
      "minLength": 1
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order",
          "legacy_keys"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "legacy_keys": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
