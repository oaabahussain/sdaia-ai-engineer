{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "runtime-bundle.schema.json",
  "type": "object",
  "required": [
    "contract_version",
    "track",
    "exam_profile",
    "concepts",
    "learn",
    "cases",
    "domains"
  ],
  "properties": {
    "contract_version": {
      "const": 3
    },
    "track": {
      "$ref": "track-manifest.schema.json"
    },
    "exam_profile": {
      "$ref": "exam-profile-v2.schema.json"
    },
    "concepts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array"
      }
    },
    "learn": {
      "type": "object"
    },
    "cases": {
      "type": "array"
    },
    "domains": {
      "$ref": "domain-catalog-v2.schema.json"
    }
  },
  "additionalProperties": false,
  "title": "RuntimeBundleV3"
}
