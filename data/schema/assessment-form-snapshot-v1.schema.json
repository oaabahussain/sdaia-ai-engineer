{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "form_id",
    "content_release_id",
    "exam_profile_id",
    "exam_profile_version",
    "scoring_policy_version",
    "item_version_ids",
    "option_orders",
    "locale",
    "started_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "form_id": {
      "type": "string",
      "minLength": 1
    },
    "content_release_id": {
      "type": "string",
      "minLength": 1
    },
    "exam_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "exam_profile_version": {
      "type": "string",
      "minLength": 1
    },
    "scoring_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "item_version_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "option_orders": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "uniqueItems": true
      }
    },
    "locale": {
      "type": "string",
      "enum": [
        "ar",
        "en"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "learner_id": {
      "type": "string"
    },
    "compatibility": {
      "type": "object"
    }
  }
}
