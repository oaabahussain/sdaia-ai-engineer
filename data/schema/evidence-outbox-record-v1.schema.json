{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "state",
    "attempt_count"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "state": {
      "enum": [
        "PENDING",
        "IN_FLIGHT",
        "ACKNOWLEDGED",
        "BLOCKED"
      ]
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0
    },
    "last_attempt_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_attempt_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_disposition": {
      "enum": [
        "ACCEPTED",
        "DUPLICATE",
        "CONFLICT",
        "REJECTED"
      ]
    },
    "last_reason_code": {
      "type": "string",
      "minLength": 1
    },
    "authoritative_store_id": {
      "type": "string",
      "minLength": 1
    },
    "authoritative_store_seq": {
      "type": "integer",
      "minimum": 1
    }
  }
}
