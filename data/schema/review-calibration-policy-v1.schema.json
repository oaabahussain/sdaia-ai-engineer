{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "scope",
    "evidence_basis",
    "risk_rules",
    "mandatory_human_conditions",
    "escalation_triggers",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "track",
            "domain",
            "provider",
            "risk_class"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_basis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "risk_class",
          "decision"
        ],
        "properties": {
          "risk_class": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "decision": {
            "type": "string",
            "enum": [
              "HUMAN_REQUIRED",
              "SAMPLED",
              "AUTO_ELIGIBLE",
              "HOLD"
            ]
          },
          "sampling_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "decision": {
                  "const": "SAMPLED"
                }
              }
            },
            "then": {
              "required": [
                "sampling_rate"
              ]
            }
          }
        ]
      }
    },
    "mandatory_human_conditions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "escalation_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "operator",
          "threshold",
          "action"
        ],
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "type": "string",
            "enum": [
              "gt",
              "gte",
              "lt",
              "lte"
            ]
          },
          "threshold": {
            "type": "number"
          },
          "action": {
            "type": "string",
            "enum": [
              "HUMAN_REQUIRED",
              "HOLD",
              "INCREASE_SAMPLING"
            ]
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
