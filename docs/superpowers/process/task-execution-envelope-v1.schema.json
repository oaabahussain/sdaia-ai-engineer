{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "task-execution-envelope-v1.schema.json",
  "title": "TaskExecutionEnvelopeV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_version",
    "task_id",
    "task_packet_digest",
    "state_revision",
    "base_main_sha",
    "task_base_sha",
    "execution_branch",
    "project_bootstrap_revision",
    "runtime_capability_profile_digest",
    "created_from_ref",
    "preflight_gate_set"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "envelope_version": { "const": 1 },
    "task_id": { "type": "integer", "minimum": 1 },
    "task_packet_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "state_revision": { "type": "integer", "minimum": 1 },
    "base_main_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "task_base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "execution_branch": { "type": "string", "minLength": 1 },
    "project_bootstrap_revision": { "type": "string", "minLength": 1 },
    "runtime_capability_profile_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "created_from_ref": { "type": "string", "minLength": 1 },
    "preflight_gate_set": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
