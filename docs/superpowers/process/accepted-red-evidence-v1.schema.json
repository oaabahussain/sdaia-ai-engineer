  "fixture_hashes":{"type":"object","additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
  "replaces_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"ruling":{"type":"string","minLength":1},
  "evidence_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
 }
}
