{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "process-failure-rule-v1.schema.json",
  "title": "ProcessFailureRuleV1 Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "rules"],
  "properties": {
    "schema_version": { "const": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "failure_family",
          "severity",
          "original_symptom",
          "root_cause",
          "prevention_rule",
          "validator_id",
          "regression_test_ref",
          "applies_to",
          "introduced_by_evidence",
          "status"
        ],
        "properties": {
          "rule_id": { "type": "string", "pattern": "^F\\d{3}$" },
          "failure_family": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["CRITICAL", "IMPORTANT", "MINOR"] },
          "original_symptom": { "type": "string", "minLength": 1 },
          "root_cause": { "type": "string", "minLength": 1 },
          "prevention_rule": { "type": "string", "minLength": 1 },
          "validator_id": { "type": "string", "minLength": 1 },
          "regression_test_ref": { "type": "string", "minLength": 1 },
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "introduced_by_evidence": { "type": "string", "minLength": 1 },
          "status": { "enum": ["ACTIVE", "RETIRED"] }
        }
      }
    }
  }
}
