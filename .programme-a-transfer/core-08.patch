+import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import { migrateState } from '../src/state/migrate.js';
+const raw=JSON.parse(fs.readFileSync(new URL('./fixtures/state/current-exam-v2.json',import.meta.url),'utf8'));const map=JSON.parse(fs.readFileSync(new URL('../data/migrations/sdaia-generated-v2-question-ids.json',import.meta.url),'utf8'));const ctx={anonId:raw.anon_id,questionIdMap:map,trackId:'sdaia-ai-engineer',trackVersion:'2026.09',examProfileId:'sdaia-ai-engineer.project-reference.v1',examProfileVersion:'1'};
+test('migrates unfinished current exam without losing keyed state',()=>{const s=migrateState(raw,ctx);assert.equal(s.version,2);assert.deepEqual(s.preferences,{lang:'en',theme:'dark'});const e=s.tracks['sdaia-ai-engineer'].active_exam;assert.deepEqual(e.questionIds,[map.q1,map.q2]);assert.equal(e.answers[map.q1],0);assert.equal(e.confidence[map.q1],'high');assert.equal(e.flags[map.q2],true);assert.deepEqual(e.optionOrders[map.q2],[1,0,2,3]);assert.equal(e.track_id,'sdaia-ai-engineer')});
+test('migration is idempotent',()=>{const once=migrateState(raw,ctx);assert.deepEqual(migrateState(once,ctx),once)});
