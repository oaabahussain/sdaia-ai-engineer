+test('generated questions use stable namespaced runtime IDs',()=>{const s=q[0];assert.match(s.id,/^sdaia-ai-engineer\.[a-z0-9.-]+\.v1$/);assert.match(s.family_id,/^sdaia-ai-engineer\.[a-z0-9.-]+$/);assert.equal(s.track_id,'sdaia-ai-engineer');assert.equal('legacy_id'in s,false)});
+test('stable IDs do not depend on concept array order',()=>{const reversed=Object.fromEntries(Object.entries(concepts).map(([d,l])=>[d,[...l].reverse()]));const normal=new Map(expandConceptBank(concepts,{trackId:'sdaia-ai-engineer'}).map(x=>[x.id,visible(x)]));const rev=new Map(expandConceptBank(reversed,{trackId:'sdaia-ai-engineer'}).map(x=>[x.id,visible(x)]));assert.deepEqual(rev,normal)});
 test('question IDs and bilingual prompts are unique',()=>{assert.equal(new Set(q.map(x=>x.id)).size,q.length);assert.equal(new Set(q.map(x=>`${x.domain}|${x.question}|${x.question_en}`)).size,q.length)});
 test('canonical answer positions are balanced',()=>{const c=[0,0,0,0];q.forEach(x=>c[x.answer]++);assert.ok(Math.max(...c)-Math.min(...c)<=Math.ceil(q.length*.08),c.join(','))});
 test('every domain has 160 questions',()=>{const c={};q.forEach(x=>c[x.domain]=(c[x.domain]||0)+1);Object.values(c).forEach(n=>assert.equal(n,160))});
