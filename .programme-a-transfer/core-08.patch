@@ -0,0 +1,5 @@
+import test from 'node:test';import assert from 'node:assert/strict';
+class FakeLocalStorage{constructor(){this.map=new Map()}getItem(k){return this.map.has(k)?this.map.get(k):null}setItem(k,v){this.map.set(k,String(v))}removeItem(k){this.map.delete(k)}}
+const state=id=>({version:2,anon_id:id,created_at:'2026-09-09T00:00:00Z',updated_at:'2026-09-09T00:00:00Z',preferences:{lang:'ar',theme:'light'},tracks:{'sdaia-ai-engineer':{track_version:'2026.09',active_exam:null,exam_history:[]}},legacy:{source_version:1,preserved:{}}});
+test('first API 404 and first save use one anonymous id',async()=>{globalThis.localStorage=new FakeLocalStorage();globalThis.__SDAIA_API_BASE__='http://api/v1';const calls=[];globalThis.fetch=async(url,opts={})=>{calls.push({url,opts});if((opts.method||'GET')==='GET')return{status:404,ok:false,headers:new Headers()};return{status:200,ok:true,headers:new Headers({etag:'1'}),json:async()=>({})}};const a=await import(`../src/storage/api.js?x=${Date.now()}`);assert.equal(await a.loadState(),null);const id=globalThis.localStorage.getItem('learning-platform.anon-id.v1');await a.saveState(state(id));assert.ok(calls[0].url.endsWith(`/progress/${id}`));assert.equal(calls[0].opts.headers['X-Anon-Id'],id);assert.equal(calls[1].opts.headers['X-Anon-Id'],id)});
+test('identity is stable when localStorage access throws',async()=>{Object.defineProperty(globalThis,'localStorage',{configurable:true,get(){throw new Error('blocked')}});const {getOrCreateAnonId}=await import(`../src/storage/identity.js?y=${Date.now()}`);assert.equal(getOrCreateAnonId(),getOrCreateAnonId())});
